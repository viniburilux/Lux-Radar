{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/viniburilux/Lux-Radar/blob/main/schemas/release-manifest.schema.json",
  "title": "Lux Radar Release Manifest",
  "description": "A reproducible manifest describing a versioned release of source observations and normalized records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "created_at",
    "source_ids",
    "observation_window",
    "record_counts",
    "producer"
  ],
  "properties": {
    "release_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "default_lens": {"type": "string"},
    "source_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "observation_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"}
      }
    },
    "record_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations"],
      "properties": {
        "observations": {"type": "integer", "minimum": 0},
        "evidence": {"type": "integer", "minimum": 0},
        "normalized": {"type": "integer", "minimum": 0},
        "opportunities": {"type": "integer", "minimum": 0},
        "current_opportunities": {"type": "integer", "minimum": 0},
        "signals_history": {"type": "integer", "minimum": 0},
        "moved_to_history_or_signals": {"type": "integer", "minimum": 0},
        "closing_soon": {"type": "integer", "minimum": 0},
        "new_current": {"type": "integer", "minimum": 0},
        "deduplicated": {"type": "integer", "minimum": 0},
        "collected": {"type": "integer", "minimum": 0},
        "new": {"type": "integer", "minimum": 0},
        "updated": {"type": "integer", "minimum": 0},
        "closed": {"type": "integer", "minimum": 0},
        "unchanged": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "total_candidates": {"type": "integer", "minimum": 0},
        "total_verified": {"type": "integer", "minimum": 0},
        "total_closed": {"type": "integer", "minimum": 0},
        "total_unknown": {"type": "integer", "minimum": 0},
        "total_insufficient_evidence": {"type": "integer", "minimum": 0},
        "sustainability_records": {"type": "integer", "minimum": 0},
        "sustainability_lens_records": {"type": "integer", "minimum": 0},
        "non_sustainability_records": {"type": "integer", "minimum": 0},
        "unclassified_records": {"type": "integer", "minimum": 0},
        "domain_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"type": "string"},
          "ref": {"type": "string"},
          "content_hash": {"type": "string"},
          "media_type": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "format": "uri"}
      }
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "temporal_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "status"],
        "properties": {
          "source_id": {"type": "string"},
          "field": {"type": "string"},
          "before": {},
          "after": {},
          "status": {"type": "string"},
          "observation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "license_or_terms_note": {"type": "string"}
  }
}
